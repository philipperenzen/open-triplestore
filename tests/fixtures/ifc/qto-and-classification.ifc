ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('qto-and-classification.ifc','2026-09-15T00:00:00',(''),(''),'hand-authored','open-triplestore tests','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Project units as Revit exports them: millimetres for length, SI otherwise. */
#10= IFCUNITASSIGNMENT((#11,#12,#13,#14,#15));
#11= IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12= IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13= IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14= IFCSIUNIT(*,.MASSUNIT.,.KILO.,.GRAM.);
#15= IFCSIUNIT(*,.TIMEUNIT.,$,.SECOND.);
#16= IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);
#17= IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
/* A conversion-based inch (mappable) and a furlong (not). */
#18= IFCCONVERSIONBASEDUNIT(#16,.LENGTHUNIT.,'INCH',#19);
#19= IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(0.0254),#17);
#20= IFCCONVERSIONBASEDUNIT(#16,.LENGTHUNIT.,'FURLONG',#21);
#21= IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(201.168),#17);
#1= IFCPROJECT('0BBBBBBBBBBBBBBBBBBBP1',$,'House',$,$,$,$,(),#10);
#30= IFCSITE('0BBBBBBBBBBBBBBBBBBBS1',$,'Site',$,$,$,$,$,.ELEMENT.,$,$,$,$,$);
#31= IFCBUILDING('0BBBBBBBBBBBBBBBBBBBB1',$,'House',$,$,$,$,$,.ELEMENT.,$,$,$);
#32= IFCBUILDINGSTOREY('0BBBBBBBBBBBBBBBBBBBL1',$,'Ground floor',$,$,$,$,$,.ELEMENT.,0.);
#40= IFCWALL('0BBBBBBBBBBBBBBBBBBBW1',$,'Wall-01',$,$,$,$,'W1',.SOLIDWALL.);
#50= IFCRELAGGREGATES('0BBBBBBBBBBBBBBBBBBBR1',$,$,$,#1,(#30));
#51= IFCRELAGGREGATES('0BBBBBBBBBBBBBBBBBBBR2',$,$,$,#30,(#31));
#52= IFCRELAGGREGATES('0BBBBBBBBBBBBBBBBBBBR3',$,$,$,#31,(#32));
#53= IFCRELCONTAINEDINSPATIALSTRUCTURE('0BBBBBBBBBBBBBBBBBBBR4',$,$,$,(#40),#32);
/* Base quantities: project defaults, an own unit, a count, a complex quantity,
   a quantity in inches and one in furlongs. */
#60= IFCELEMENTQUANTITY('0BBBBBBBBBBBBBBBBBBBQ1',$,'Qto_WallBaseQuantities',$,'BaseQuantities',(#61,#62,#63,#64,#65,#66,#67,#69,#70));
#61= IFCQUANTITYLENGTH('Length',$,$,4000.,$);
#62= IFCQUANTITYAREA('GrossSideArea',$,$,12.5,$);
#63= IFCQUANTITYVOLUME('NetVolume',$,#13,2.4,$);
#64= IFCQUANTITYCOUNT('Count',$,$,1,$);
#65= IFCQUANTITYWEIGHT('Weight',$,$,850.,$);
#66= IFCQUANTITYTIME('Duration',$,$,3.5,$);
#67= IFCPHYSICALCOMPLEXQUANTITY('Layers',$,(#68),'Layer',$,$);
#68= IFCQUANTITYLENGTH('Thickness',$,$,200.,$);
#69= IFCQUANTITYLENGTH('Width',$,#18,36.,$);
#70= IFCQUANTITYLENGTH('Run',$,#20,2.,$);
#71= IFCRELDEFINESBYPROPERTIES('0BBBBBBBBBBBBBBBBBBBR5',$,$,$,(#40),#60);
/* Every property kind: single (with and without a unit), enumerated, list,
   bounded, complex. */
#80= IFCPROPERTYSET('0BBBBBBBBBBBBBBBBBBBT1',$,'Pset_WallCommon',$,(#81,#82,#83,#84,#85,#86));
#81= IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#82= IFCPROPERTYSINGLEVALUE('Height',$,IFCPOSITIVELENGTHMEASURE(2800.),$);
#83= IFCPROPERTYENUMERATEDVALUE('FireRating',$,(IFCLABEL('REI60')),#88);
#84= IFCPROPERTYLISTVALUE('Colours',$,(IFCLABEL('red'),IFCLABEL('blue')),$);
#85= IFCPROPERTYBOUNDEDVALUE('Span',$,IFCLENGTHMEASURE(5000.),IFCLENGTHMEASURE(3000.),$,$);
#86= IFCCOMPLEXPROPERTY('Layer1',$,'Layers',(#87));
#87= IFCPROPERTYSINGLEVALUE('Material',$,IFCLABEL('Brick'),$);
#88= IFCPROPERTYENUMERATION('PEnum_FireRating',(IFCLABEL('REI30'),IFCLABEL('REI60')),$);
#89= IFCRELDEFINESBYPROPERTIES('0BBBBBBBBBBBBBBBBBBBR6',$,$,$,(#40),#80);
/* The IFC4 set form of RelatingPropertyDefinition. */
#90= IFCPROPERTYSET('0BBBBBBBBBBBBBBBBBBBT2',$,'Pset_Extra',$,(#91));
#91= IFCPROPERTYSINGLEVALUE('Note',$,IFCTEXT('via the set form'),$);
#92= IFCRELDEFINESBYPROPERTIES('0BBBBBBBBBBBBBBBBBBBR7',$,$,$,(#40),IFCPROPERTYSETDEFINITIONSET((#90)));
/* A two-level classification reference and a material. The scheme, its codes
   and titles are made up (example.org), shaped like a Uniclass table, so no
   real classification table is reproduced or misquoted. */
#100= IFCCLASSIFICATION('Example Publisher','1.0',$,'Example Classification',$,'https://example.org/classification',$);
#101= IFCCLASSIFICATIONREFERENCE('https://example.org/classification/ex','EX','Example systems',#100,$,$);
#102= IFCCLASSIFICATIONREFERENCE($,'EX_20_10','Brick walls',#101,'Load-bearing walls of brick or block',$);
#103= IFCRELASSOCIATESCLASSIFICATION('0BBBBBBBBBBBBBBBBBBBR8',$,$,$,(#40),#102);
#110= IFCMATERIAL('Brick',$,$);
#111= IFCRELASSOCIATESMATERIAL('0BBBBBBBBBBBBBBBBBBBR9',$,$,$,(#40),#110);
ENDSEC;
END-ISO-10303-21;
