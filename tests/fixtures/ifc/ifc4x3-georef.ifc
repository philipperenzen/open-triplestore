ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('ifc4x3-georef.ifc','2026-09-15T00:00:00',(''),(''),'hand-authored','open-triplestore tests','');
FILE_SCHEMA(('IFC4X3_ADD2'));
ENDSEC;
DATA;
/* Units: metres, square metres, cubic metres, the kilogram trap (KILO + GRAM),
   and a conversion-based degree defined against the SI radian. */
#10= IFCUNITASSIGNMENT((#11,#12,#13,#14,#15));
#11= IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#12= IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13= IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14= IFCSIUNIT(*,.MASSUNIT.,.KILO.,.GRAM.);
#15= IFCCONVERSIONBASEDUNIT(#16,.PLANEANGLEUNIT.,'DEGREE',#17);
#16= IFCDIMENSIONALEXPONENTS(0,0,0,0,0,0,0);
#17= IFCMEASUREWITHUNIT(IFCPLANEANGLEMEASURE(0.0174532925199433),#18);
#18= IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
/* The model context, georeferenced through a map conversion onto RD New. */
#20= IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#21,$);
#21= IFCAXIS2PLACEMENT3D(#22,$,$);
#22= IFCCARTESIANPOINT((0.,0.,0.));
#30= IFCMAPCONVERSION(#20,#31,155000.,463000.,10.,0.9998,0.02,1.);
#31= IFCPROJECTEDCRS('EPSG:28992','Amersfoort / RD New','Amersfoort','NAP','Oblique Stereographic',$,#11);
#1= IFCPROJECT('0AAAAAAAAAAAAAAAAAAAP1',$,'Bridge project',$,$,$,$,(#20),#10);
#40= IFCSITE('0AAAAAAAAAAAAAAAAAAAS1',$,'Site',$,$,$,$,$,.ELEMENT.,(52,9,0,0),(5,23,0,0),0.,$,$);
#41= IFCBRIDGE('0AAAAAAAAAAAAAAAAAAAB1',$,'Waalbrug',$,$,$,$,$,.ELEMENT.,.ARCHED.);
#42= IFCBRIDGEPART('0AAAAAAAAAAAAAAAAAAAD1',$,'Deck',$,$,$,$,$,.ELEMENT.,.LONGITUDINAL.,.DECK.);
#43= IFCBEAM('0AAAAAAAAAAAAAAAAAAAE1',$,'Girder',$,$,$,$,'G1',.BEAM.);
#44= IFCALIGNMENT('0AAAAAAAAAAAAAAAAAAAA1',$,'Alignment A',$,$,$,$,$);
#50= IFCRELAGGREGATES('0AAAAAAAAAAAAAAAAAAAR1',$,$,$,#1,(#40));
#51= IFCRELAGGREGATES('0AAAAAAAAAAAAAAAAAAAR2',$,$,$,#40,(#41,#44));
#52= IFCRELAGGREGATES('0AAAAAAAAAAAAAAAAAAAR3',$,$,$,#41,(#42));
#53= IFCRELCONTAINEDINSPATIALSTRUCTURE('0AAAAAAAAAAAAAAAAAAAR4',$,$,$,(#43),#42);
/* One quantity set on the girder, in project units (metres, kilograms). */
#60= IFCELEMENTQUANTITY('0AAAAAAAAAAAAAAAAAAAQ1',$,'Qto_BeamBaseQuantities',$,'BaseQuantities',(#61,#62));
#61= IFCQUANTITYLENGTH('Length',$,$,24.5,$);
#62= IFCQUANTITYWEIGHT('GrossWeight',$,$,1850.,$);
#63= IFCRELDEFINESBYPROPERTIES('0AAAAAAAAAAAAAAAAAAAR5',$,$,$,(#43),#60);
ENDSEC;
END-ISO-10303-21;
