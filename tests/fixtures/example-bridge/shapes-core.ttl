# Reference example: a fictional arch bridge — SHACL Core shapes.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix bot:  <https://w3id.org/bot#> .
@prefix def:  <https://example.org/def/> .
@prefix ex:   <https://example.org/shape/def#> .

### Cardinality, datatype, nodeKind, class, code list
def:NavigableBridge
    a sh:NodeShape ;
    sh:targetClass def:NavigableBridge ;
    sh:property [ sh:path def:constructionYear ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:gYear ;
        sh:message "Construction year required: exactly one, typed xsd:gYear."@en ] ;
    sh:property [ sh:path def:movable ;
        sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path def:spanCount ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path geo:hasGeometry ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "Exactly one geo:hasGeometry required."@en ] ;
    sh:property [ sh:path def:clearanceHeight ;
        sh:minCount 1 ; sh:class qudt:QuantityValue ;
        sh:message "A bridge over a navigable waterway needs a clearance height (QUDT)."@en ] .

def:Arch
    a sh:NodeShape ; sh:targetClass def:Arch ;
    sh:property [ sh:path def:material ;
        sh:minCount 1 ; sh:in ( def:steel def:concrete ) ;
        sh:message "Material must be steel or concrete."@en ] .

### Pattern (regex), language tags, unique language
ex:GuidShape a sh:NodeShape ;
    sh:targetClass def:BridgeComponent ;
    sh:property [ sh:path def:ifcGuid ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9A-Za-z_$]{22}$" ;     # IFC GlobalId = 22 base64-ish chars
        sh:maxCount 1 ;
        sh:message "ifcGuid must be 22 valid IFC GlobalId characters."@en ] .

ex:LabelShape a sh:NodeShape ;
    sh:targetClass def:Structure ;
    sh:property [ sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:languageIn ( "nl" "en" ) ;
        sh:uniqueLang true ;
        sh:message "Labels must be nl and/or en, at most one per language."@en ] .

### Qualified value shapes + sh:or (geometry choice) — uses a complex property path
ex:BridgeStructureShape a sh:NodeShape ;
    sh:targetClass def:Bridge ;
    sh:property [ sh:path bot:containsElement ;
        sh:qualifiedValueShape [ sh:class def:Arch ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A bridge must contain at least one arch (def:Arch)."@en ] ;
    sh:property [ sh:path ( geo:hasGeometry [ sh:alternativePath ( geo:asWKT geo:asGML ) ] ) ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype geo:wktLiteral ] [ sh:datatype geo:gmlLiteral ] ) ;
        sh:message "Geometry must be a WKT or GML literal."@en ] .
