@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://example.org/layered/dataset/assets> a dcat:Dataset ;
    dct:title "Assets" ;
    dct:description "Bridges with their status, conforming to the asset model." ;
    dct:conformsTo <https://example.org/layered/def> ;
    dcat:distribution <https://example.org/layered/dataset/assets/ttl> .
<https://example.org/layered/dataset/assets/ttl> a dcat:Distribution ; dcat:mediaType "text/turtle" .
