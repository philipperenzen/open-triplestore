@prefix ex:  <https://example.org/layered/def#> .
@prefix exd: <https://example.org/layered/values/> .
@prefix exv: <https://example.org/layered/vocab/> .
@prefix id:  <https://example.org/layered/asset/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

id:b1 a ex:Bridge ; ex:name "Riverside Bridge" ; ex:kind exv:bridge ; ex:status exd:in-service     ; ex:spanMetres "120.0"^^xsd:decimal .
id:b2 a ex:Bridge ; ex:name "Cycle Bridge" ;     ex:kind exv:bridge ; ex:status exd:out-of-service ; ex:spanMetres "64.0"^^xsd:decimal .
# b3 has no status: the planted violation.
id:b3 a ex:Bridge ; ex:name "East Crossing" ;    ex:kind exv:bridge ; ex:spanMetres "180.0"^^xsd:decimal .
