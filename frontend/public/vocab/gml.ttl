  rdfs:label "PolyhedralSurface"@en ;
  rdfs:comment "The GML 3.2.1 element gml:PolyhedralSurface (geometryPrimitives.xsd), in the substitution group of gml:Surface."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:TriangulatedSurface a owl:Class ;
  rdfs:subClassOf gml:Surface ;
  rdfs:label "TriangulatedSurface"@en ;
  rdfs:comment "The GML 3.2.1 element gml:TriangulatedSurface (geometryPrimitives.xsd), in the substitution group of gml:Surface."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Tin a owl:Class ;
