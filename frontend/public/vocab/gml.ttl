  rdfs:label "OrientableCurve"@en ;
  rdfs:comment "The GML 3.2.1 element gml:OrientableCurve (geometryPrimitives.xsd), in the substitution group of gml:AbstractCurve."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Ring a owl:Class ;
  rdfs:subClassOf gml:AbstractRing ;
  rdfs:label "Ring"@en ;
  rdfs:comment "The GML 3.2.1 element gml:Ring (geometryPrimitives.xsd), in the substitution group of gml:AbstractRing."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Surface a owl:Class ;
  rdfs:subClassOf gml:AbstractSurface ;
  rdfs:label "Surface"@en ;
  rdfs:comment "The GML 3.2.1 element gml:Surface (geometryPrimitives.xsd), in the substitution group of gml:AbstractSurface."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:OrientableSurface a owl:Class ;
  rdfs:subClassOf gml:AbstractSurface ;
  rdfs:label "OrientableSurface"@en ;
  rdfs:comment "The GML 3.2.1 element gml:OrientableSurface (geometryPrimitives.xsd), in the substitution group of gml:AbstractSurface."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:PolyhedralSurface a owl:Class ;
