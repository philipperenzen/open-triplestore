  rdfs:comment "The GML 3.2.1 element gml:GeometricComplex (geometryComplexes.xsd), in the substitution group of gml:AbstractGeometry."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:CompositeCurve a owl:Class ;
