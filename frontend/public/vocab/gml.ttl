# GML 3.2.1 geometry class hierarchy — written by Open Triplestore for the
# GeoSPARQL RDFS Entailment Extension (OGC 11-052r4 Req 27, 22-047r1 Req 49):
# "an RDFS/OWL class hierarchy of geometry types consistent with the GML schema".
# OGC no longer publishes an RDF version of that hierarchy, so this file derives
# one class per GML geometry element, with rdfs:subClassOf following the
# element's substitutionGroup, from the GML 3.2.1 schema at
# https://schemas.opengis.net/gml/3.2.1/ (geometryBasic0d1d.xsd, geometryBasic2d.xsd,
# geometryPrimitives.xsd, geometryAggregates.xsd, geometryComplexes.xsd, grids.xsd;
# retrieved 2026-10-03, the files carry version="3.2.2", OGC's corrigendum that
# kept the 3.2.1 namespace http://www.opengis.net/gml/3.2).
# A geometry element is one in the substitution group of gml:AbstractGeometry,
# directly or indirectly. Elements in the gml:AbstractObject group (gml:Envelope,
# the curve segments and the surface patches such as gml:PolygonPatch and
# gml:Triangle) are not geometries in GML 3.2.1 and have no class here.
# gml:AbstractGeometry, whose own substitution group is gml:AbstractGML, is a
# subclass of geo:Geometry. The GeoSPARQL 1.0 text's example
# "gml:Polygon rdfs:subClassOf gml:SurfacePatch" does not match the schema
# (gml:Polygon substitutes for gml:AbstractSurface); this file follows the schema.
# No schema text is copied: only element names and their substitution groups.
# Written by Open Triplestore; under the project licence (see LICENSE).
@prefix gml:  <http://www.opengis.net/ont/gml#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://www.opengis.net/ont/gml> a owl:Ontology ;
  rdfs:label "GML 3.2.1 geometry types"@en ;
  rdfs:comment "One class per GML 3.2.1 geometry element; rdfs:subClassOf follows the element's substitution group in the GML 3.2.1 schema. Written by Open Triplestore for the GeoSPARQL RDFS Entailment Extension."@en ;
  dcterms:source <https://schemas.opengis.net/gml/3.2.1/> ;
  owl:versionInfo "1.0" .

gml:AbstractGeometry a owl:Class ;
  rdfs:subClassOf geo:Geometry ;
  rdfs:label "AbstractGeometry"@en ;
  rdfs:comment "The GML 3.2.1 element gml:AbstractGeometry (geometryBasic0d1d.xsd), in the substitution group of gml:AbstractGML."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:AbstractGeometricPrimitive a owl:Class ;
  rdfs:subClassOf gml:AbstractGeometry ;
  rdfs:label "AbstractGeometricPrimitive"@en ;
  rdfs:comment "The GML 3.2.1 element gml:AbstractGeometricPrimitive (geometryBasic0d1d.xsd), in the substitution group of gml:AbstractGeometry."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Point a owl:Class ;
  rdfs:subClassOf gml:AbstractGeometricPrimitive ;
  rdfs:label "Point"@en ;
  rdfs:comment "The GML 3.2.1 element gml:Point (geometryBasic0d1d.xsd), in the substitution group of gml:AbstractGeometricPrimitive."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:AbstractCurve a owl:Class ;
  rdfs:subClassOf gml:AbstractGeometricPrimitive ;
  rdfs:label "AbstractCurve"@en ;
  rdfs:comment "The GML 3.2.1 element gml:AbstractCurve (geometryBasic0d1d.xsd), in the substitution group of gml:AbstractGeometricPrimitive."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:LineString a owl:Class ;
  rdfs:subClassOf gml:AbstractCurve ;
  rdfs:label "LineString"@en ;
  rdfs:comment "The GML 3.2.1 element gml:LineString (geometryBasic0d1d.xsd), in the substitution group of gml:AbstractCurve."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:AbstractSurface a owl:Class ;
  rdfs:subClassOf gml:AbstractGeometricPrimitive ;
  rdfs:label "AbstractSurface"@en ;
  rdfs:comment "The GML 3.2.1 element gml:AbstractSurface (geometryBasic2d.xsd), in the substitution group of gml:AbstractGeometricPrimitive."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Polygon a owl:Class ;
  rdfs:subClassOf gml:AbstractSurface ;
  rdfs:label "Polygon"@en ;
  rdfs:comment "The GML 3.2.1 element gml:Polygon (geometryBasic2d.xsd), in the substitution group of gml:AbstractSurface."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:AbstractRing a owl:Class ;
  rdfs:subClassOf gml:AbstractCurve ;
  rdfs:label "AbstractRing"@en ;
  rdfs:comment "The GML 3.2.1 element gml:AbstractRing (geometryBasic2d.xsd), in the substitution group of gml:AbstractCurve."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:LinearRing a owl:Class ;
  rdfs:subClassOf gml:AbstractRing ;
  rdfs:label "LinearRing"@en ;
  rdfs:comment "The GML 3.2.1 element gml:LinearRing (geometryBasic2d.xsd), in the substitution group of gml:AbstractRing."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:Curve a owl:Class ;
  rdfs:subClassOf gml:AbstractCurve ;
  rdfs:label "Curve"@en ;
  rdfs:comment "The GML 3.2.1 element gml:Curve (geometryPrimitives.xsd), in the substitution group of gml:AbstractCurve."@en ;
  rdfs:isDefinedBy <http://www.opengis.net/ont/gml> .

gml:OrientableCurve a owl:Class ;
