# syntax=docker/dockerfile:1
# Benchmark image of Open Triplestore: `cargo build --release --features full`
# (fat LTO, codegen-units=1 — the shipped release profile) in a Linux container,
# so the server runs under the same Docker memory/CPU limits as every other store
# in the comparison. Unlike the production Dockerfile it skips the web UI bundle,
# the LOV corpus and the licence-notice generator: none of them affects query,
# load or validation speed, and leaving them out keeps the build small.
#
#   docker build -f scripts/bench-compare/Dockerfile.ots -t ots-bench:<sha> .
#
# Base images are pinned by digest (linux/arm64 and linux/amd64 manifests lists).
FROM rust:1.94-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-dev cmake pkg-config libclang-dev lld libxml2-dev libxmlsec1-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV CARGO_BUILD_JOBS=6 RUST_MIN_STACK=33554432
# The shipped profile is fat LTO. Its link of the `full` binary needs about
# 14 GB, more than a 16 GB laptop's Docker VM has free next to other
# containers; `--build-arg CARGO_PROFILE_RELEASE_LTO=thin` builds with thin LTO
# instead, and a run that does so says so in its inputs.json.
ARG CARGO_PROFILE_RELEASE_LTO=true
ENV CARGO_PROFILE_RELEASE_LTO=${CARGO_PROFILE_RELEASE_LTO}
COPY .cargo/ .cargo/
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
COPY benches/ benches/
COPY opengraph/ opengraph/
COPY plugins/ plugins/
COPY tools/ tools/
COPY docs/ docs/
COPY examples/ examples/
# The Oxigraph crates patched in through [patch.crates-io] (vendor/README.md).
COPY vendor/ vendor/
COPY frontend/public/vocab/ frontend/public/vocab/
COPY frontend/public/samples/ frontend/public/samples/
COPY assets/ assets/
# Cargo.toml declares [[test]] targets; cargo refuses to parse the manifest
# when their sources are missing, even for a plain `cargo build`.
COPY tests/ tests/
# Build and keep only the binary. target/ lives in a BuildKit cache, so a build of the next commit recompiles
# only what changed (the dependencies took about two hours on the laptop of the
# comparison); it is not part of any image layer.
# The cache is shared by every checkout built on the machine, and cargo
# decides what changed by file modification times, which COPY keeps: a commit
# whose sources are older than the last build of another checkout was taken
# as up to date and got that checkout's binary. Touching the workspace's own
# sources makes cargo rebuild them (and only them) every time.
RUN --mount=type=cache,id=cargo-registry,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,sharing=locked,target=/usr/local/cargo/git \
    --mount=type=cache,id=ots-bench-target,sharing=locked,target=/app/target \
    find src opengraph plugins tools vendor benches examples tests -name '*.rs' -exec touch {} + \
    && cargo build --release --features full \
    && cp target/release/open-triplestore /usr/local/bin/open-triplestore

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgeos-c1v5 ca-certificates curl libxml2 libxmlsec1-openssl libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/open-triplestore /usr/local/bin/open-triplestore
RUN mkdir -p /data
EXPOSE 7878
ENTRYPOINT ["open-triplestore"]
CMD ["--data-dir", "/data", "--port", "7878", "--bind", "0.0.0.0"]
