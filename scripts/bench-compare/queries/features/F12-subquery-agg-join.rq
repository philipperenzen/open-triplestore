PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX inst: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX country: <http://downlode.org/rdf/iso-3166/countries#>
# Subquery: offers priced above the average price for their product
SELECT (COUNT(*) AS ?n) WHERE { ?offer bsbm:product ?product ; bsbm:price ?price . { SELECT ?product (AVG(xsd:double(str(?p))) AS ?avg) WHERE { ?o bsbm:product ?product ; bsbm:price ?p } GROUP BY ?product } FILTER (xsd:double(str(?price)) > ?avg) }
