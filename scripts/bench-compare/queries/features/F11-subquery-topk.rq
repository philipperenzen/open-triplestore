PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX inst: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX country: <http://downlode.org/rdf/iso-3166/countries#>
# Subquery: the ten producers with the most offers, with their labels
SELECT ?producer ?label ?offers WHERE { { SELECT ?producer (COUNT(?offer) AS ?offers) WHERE { ?offer bsbm:product ?product . ?product bsbm:producer ?producer } GROUP BY ?producer ORDER BY DESC(?offers) ?producer LIMIT 10 } ?producer rdfs:label ?label } ORDER BY DESC(?offers) ?producer
