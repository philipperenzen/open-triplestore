# SHACL validation demo data — deliberately mixed conforming / NON-conforming 3D
# features so the built-in "Geo & 3D data" and "3D file" example pipelines always
# produce a clickable failure. Wired to the viewer-3d-demo dataset so a failing
# result can be opened straight in the 3D/map viewer ("Show in 3D").
#
# Geometry sits JUST EAST of the volumes-3d demo blocks (RD New / EPSG:7415,
# 185720..185760 × 427940..427960), on open ground so nothing overlaps the real
# 3DBAG buildings. Each named feature also carries a plain CRS84 POINT as its 2D
# map anchor, listed first, so the map path has coordinates without touching the
# volumetric literal.
#
# Conformance summary (against the seeded example shapes):
#   v3v:GoodTower   — closed 6-face solid, full metadata  → CONFORMS
#   v3v:BrokenShed  — degenerate 2-face shell             → FAILS 3D closure
#   v3v:GhostUnit   — no geometry at all                  → FAILS geometry-present
#   v3v:GoodGltfDist / v3v:GoodIfcDist — full file metadata → CONFORM
#   v3v:BadModelDist — 3D distribution missing dct:format  → FAILS 3D-file metadata

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix bot:     <https://w3id.org/bot#> .
@prefix v3v:     <https://opentriplestore.org/demo/viewer-3d-demo/validation#> .

# Zone grouping the validation-demo features.
v3v:ValidationZone a bot:Zone ;
    rdfs:label "SHACL 3D validation demo (mixed valid / invalid)"@en ;
    rdfs:comment "Deliberately mixed features to demonstrate SHACL validation and the Show-in-3D flow."@en ;
    bot:containsElement v3v:GoodTower , v3v:BrokenShed , v3v:GhostUnit .

# ── GoodTower — closed 6-face solid, 12 m × 12 m × 8 m — CONFORMS ──
v3v:GoodTower a bot:Element , geo:Feature ;
    rdfs:label "Good tower (closed solid)"@en ;
    dcterms:description "A watertight POLYHEDRALSURFACE Z with all six faces — the conforming reference case." ;
    geo:hasGeometry [ a geo:Geometry ;
        geo:asWKT "POINT(5.83330 51.83935)"^^geo:wktLiteral ] ;
    geo:hasGeometry [ a geo:Geometry ;
        geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/7415> POLYHEDRALSURFACE Z (((185730 427945 0,185730 427957 0,185742 427957 0,185742 427945 0,185730 427945 0)),((185730 427945 8,185742 427945 8,185742 427957 8,185730 427957 8,185730 427945 8)),((185730 427945 0,185730 427945 8,185730 427957 8,185730 427957 0,185730 427945 0)),((185742 427945 0,185742 427957 0,185742 427957 8,185742 427945 8,185742 427945 0)),((185730 427945 0,185742 427945 0,185742 427945 8,185730 427945 8,185730 427945 0)),((185730 427957 0,185730 427957 8,185742 427957 8,185742 427957 0,185730 427957 0)))"^^geo:wktLiteral ] .

# ── BrokenShed — degenerate 2-face shell — FAILS the 3D closure check ──
# It DOES carry a map anchor and a (broken) solid, so it renders in the viewer
# and its failing result can be opened with "Show in 3D".
v3v:BrokenShed a bot:Element , geo:Feature ;
    rdfs:label "Broken shed (unclosed shell)"@en ;
    dcterms:description "Only a bottom and a top face — the side walls are missing, so this solid is not watertight." ;
    geo:hasGeometry [ a geo:Geometry ;
        geo:asWKT "POINT(5.83370 51.83933)"^^geo:wktLiteral ] ;
    geo:hasGeometry [ a geo:Geometry ;
        geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/7415> POLYHEDRALSURFACE Z (((185750 427945 0,185750 427952 0,185758 427952 0,185758 427945 0,185750 427945 0)),((185750 427945 5,185758 427945 5,185758 427952 5,185750 427952 5,185750 427945 5)))"^^geo:wktLiteral ] .

# ── GhostUnit — no geometry — FAILS the geometry-present check ──
v3v:GhostUnit a bot:Element , geo:Feature ;
    rdfs:label "Ghost unit (no geometry)"@en ;
    dcterms:description "A spatial feature that declares no geometry at all." .

# ── 3D file distributions (dcat:Distribution) for the 3D-file metadata example ──
v3v:GoodGltfDist a dcat:Distribution ;
    dcterms:title "GoodTower glTF model"@en ;
    dcterms:format "model/gltf-binary" ;
    dcterms:conformsTo <https://www.khronos.org/gltf/> ;
    dcat:downloadURL <https://opentriplestore.org/demo/models/good-tower.glb> ;
    dcat:mediaType "model/gltf-binary" .

v3v:GoodIfcDist a dcat:Distribution ;
    dcterms:title "Reference IFC model"@en ;
    dcterms:format "application/x-step" ;
    dcterms:conformsTo <https://technical.buildingsmart.org/standards/ifc/> ;
    dcat:downloadURL <https://opentriplestore.org/demo/models/reference.ifc> ;
    dcat:mediaType "application/x-step" .

# Missing dct:format — FAILS the 3D-file metadata example.
v3v:BadModelDist a dcat:Distribution ;
    dcterms:title "Untyped 3D model distribution"@en ;
    dcat:downloadURL <https://opentriplestore.org/demo/models/mystery.bin> .
